{% extends "base.html.j2" %}
{% block style %}
<style>
  #models :is(th, td):is(:nth-child(-n+2), :nth-child(5)) { text-align: left; }
</style>
{% endblock %}
{% block title %}Hot Open Models{% endblock %}
{% block content %}
  <h1>Hot Open Models</h1>
  <p class="sub">
    Open-weight models served on OpenRouter and released in the last {{ days }} days,
    ranked by Hugging Face trending score. Click a column to re-sort.
  </p>
  <div class="wrap">
    <table id="models">
      <thead>
        <tr>
          <th data-type="num">#</th>
          <th data-type="str">Model</th>
          <th data-type="str">Released</th>
          <th data-type="num">Params</th>
          <th data-type="str">License</th>
          <th data-type="num" aria-sort="descending">Trending</th>
          <th data-type="num">Likes</th>
          <th data-type="num" title="Last 30 days, base repo plus quantized derivatives">Downloads</th>
          <th data-type="num" title="Artificial Analysis Intelligence Index">AA index</th>
          <th data-type="num" title="Cheapest OpenRouter price, USD per 1M output tokens">$/M out</th>
        </tr>
      </thead>
      <tbody>
      {% for m in models %}
        <tr>
          <td class="rank" data-v="{{ loop.index }}">{{ loop.index }}</td>
          <td data-v="{{ m.name }}">
            <a href="https://huggingface.co/{{ m.hf_id }}">{{ m.name }}</a>
            <span class="id">{{ m.hf_id }}</span>
          </td>
          <td data-v="{{ m.created.isoformat() }}">{{ m.created.strftime("%Y-%m-%d") }}</td>
          <td data-v="{{ m.params or -1 }}">{{ m.params | compact }}</td>
          <td data-v="{{ m.license or '' }}">{{ m.license or "–" }}</td>
          <td data-v="{{ m.trending }}">{{ m.trending }}</td>
          <td data-v="{{ m.likes }}">{{ m.likes | compact }}</td>
          <td data-v="{{ m.total_downloads }}" title="base {{ m.downloads | compact }} · quantized {{ m.quant_downloads | compact }}">{{ m.total_downloads | compact }}</td>
          <td data-v="{{ m.aa_index if m.aa_index is not none else -1 }}">{{ m.aa_index if m.aa_index is not none else "–" }}</td>
          <td data-v="{{ m.price_out if m.price_out is not none else -1 }}">{{ "%.2f" | format(m.price_out) if m.price_out is not none else "–" }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
  <footer>
    Generated {{ generated.strftime("%Y-%m-%d %H:%M UTC") }} from the OpenRouter and Hugging Face APIs ·
    <a href="models.json">models.json</a>
  </footer>
{% endblock %}
